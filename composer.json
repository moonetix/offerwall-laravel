{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "moonetix/offerwall-laravel",
    "type": "project",
    "description": "Laravel example app with the Moonetix offerwall: signed Earn page link and a verified, idempotent postback route.",
    "keywords": ["laravel", "offerwall", "postback", "moonetix", "rewards"],
    "homepage": "https://moonetix.com/academy/integrations/offerwall-php-laravel",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "13.40.0"
    },
    "require-dev": {
        "fakerphp/faker": "1.24.1",
        "mockery/mockery": "1.6.15",
        "nunomaduro/collision": "8.9.6",
        "phpunit/phpunit": "11.5.57"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --force --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
