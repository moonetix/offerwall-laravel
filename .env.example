APP_NAME="Offerwall Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Moonetix dashboard: Offerwalls, your offerwall, Integration
MOONETIX_APP_ID=your-app-id
MOONETIX_LINK_SALT=your-link-hash-salt
# Moonetix dashboard: Postback page
MOONETIX_POSTBACK_KEY=your-postback-secret-key

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite for the demo. Use MySQL, MariaDB or PostgreSQL in production.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
